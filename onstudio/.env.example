# OnStudio — variables de entorno (PLANTILLA)
#
# Copia este archivo a `.env` y completa los valores. `.env` está git-ignored:
# NUNCA se commitea una llave real (lo impide el .gitignore de onstudio/ y el raíz).
#
#   cp .env.example .env
#
# Las llaves se resuelven en opencode.json mediante {env:VAR}, así que viven solo
# en el entorno del servidor y nunca llegan al navegador.

# ─────────────────────────────────────────────────────────────────────────────
# LLAVES DE PROVEEDORES DE IA  (← AQUÍ va tu API. Completa la que vayas a usar.)
# Déjalas vacías hasta tener la llave. OnStudio es multi-proveedor (OpenCode).
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SERVIDOR OPENCODE (motor de generación)
# Si OnStudio lo lanza como proceso hijo, usa auth básica con estas credenciales.
# Genera una contraseña fuerte; NO la dejes en blanco en producción local.
# ─────────────────────────────────────────────────────────────────────────────
OPENCODE_SERVER_USERNAME=onstudio
OPENCODE_SERVER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# ONSTUDIO (servidor Go)
# ─────────────────────────────────────────────────────────────────────────────
ONSTUDIO_PORT=8100
OPENCODE_PORT=4096
ONSTUDIO_DATA_DIR=./data
