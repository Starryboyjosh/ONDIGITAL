{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/README.md",
      "REDISENO.md",
      "quality-check.mjs",
      "equipo/*.png",
      "equipo/*.jpg",
      "assets/ondigital-logo-generated.png",
      "**/*-debug.log",
      "assets/brand/vito.png"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "//": "Firebase suma las cabeceras de todas las reglas que casan y, ante la misma clave, gana la ultima. Por eso vendor/** va DESPUES de **/*.js: si no, el motor 3D heredaria el cache corto.",
        "source": "vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
          }
        ]
      }
    ]
  }
}
