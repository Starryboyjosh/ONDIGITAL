# ONDIGITAL — root .gitignore
# Protección repo-wide de secretos y datos efímeros.
# Las plantillas *.example SÍ se versionan; los archivos reales NO.

# ── Secretos — NUNCA commitear ────────────────────────────────────────────────
# (`.env.example` no coincide con estos patrones, así que permanece versionado)
**/.env
**/.env.local
**/.env.*.local
**/auth.json
**/secrets/**
ops/subscriptions.json
**/backups/
*.key
*.pem

# ── Claude Code: ajustes locales por máquina (no compartir) ───────────────────
.claude/settings.local.json

# ── Sistema ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Graphify — caché y metadatos efímeros ────────────────────────────────────
# Los reportes/grafos oficiales de graphify-out/ sí pueden versionarse; estas
# salidas cambian por máquina y por versión de Graphify.
graphify-out/cache/
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/manifest.json

# ── Artefactos efímeros de herramientas locales ──────────────────────────────
# Salidas de corridas puntuales: cambian en cada ejecución y por máquina.
test-results/
.impeccable/

# Firebase Hosting deploy cache
.firebase/
