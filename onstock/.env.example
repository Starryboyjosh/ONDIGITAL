# ═══════════════════════════════════════════════════════════
# Vito — copiar a .env  (NUNCA subas .env a git)
#   cp .env.example .env
# Edita SOLO el archivo .env (no este .env.example)
# Reinicia: make dev
# ═══════════════════════════════════════════════════════════

VITO_ENABLED=true

# mock = sin API | opencode = API real
# Si dejas vacío: con key real → opencode; sin key → mock
VITO_PROVIDER=opencode

VITO_LOCALE=es-HN

# ── API key (OBLIGATORIA para opencode) ───────────────────
# OpenCode Zen: https://opencode.ai/auth
# Pega la key REAL en .env, en una sola línea, sin comillas:
#   VITO_OPENCODE_API_KEY=oc-xxxxxxxx
#
# NO dejes texto de ejemplo tipo pega_tu_key_aqui
VITO_OPENCODE_API_KEY=

# Alias opcional:
# OPENCODE_API_KEY=

# Endpoint (OpenAI-compatible chat/completions)
# OpenCode Zen:
VITO_OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OpenRouter (si tu key empieza con sk-or-v1-):
# VITO_OPENCODE_BASE_URL=https://openrouter.ai/api/v1

# Modelo
# Zen free: big-pickle | deepseek-v4-flash-free | mimo-v2.5-free
VITO_OPENCODE_MODEL=big-pickle
# OpenRouter ejemplo:
# VITO_OPENCODE_MODEL=openai/gpt-4o-mini
