# ═══════════════════════════════════════════════════════════
# Vito — copiar a .env  (NUNCA subas .env a git)
#   cp .env.example .env
# Edita SOLO el archivo .env (no este .env.example)
# Reinicia: make dev
# ═══════════════════════════════════════════════════════════

VITO_ENABLED=true

# Dónde corre el motor de Vito:
#   local = sin conexión, respuestas de demostración
#   nube  = servicio remoto (requiere clave)
# Si lo dejas vacío se decide solo: con clave real → nube; sin clave → local.
VITO_PROVIDER=nube

VITO_LOCALE=es-HN

# ── Clave del motor (OBLIGATORIA en modo nube) ─────────────
# Pégala en .env, en una sola línea y sin comillas:
#   VITO_API_KEY=xxxxxxxx
# NO dejes texto de ejemplo tipo pega_tu_key_aqui: se descarta.
VITO_API_KEY=

# ── Ajustes del motor (opcionales) ─────────────────────────
# Endpoint compatible con chat/completions. Vacío = el que trae por defecto.
VITO_BASE_URL=

# Identificador del modelo. Vacío = el que trae por defecto.
VITO_MODEL=

# ── Compatibilidad ─────────────────────────────────────────
# Si vienes de una versión anterior, los nombres antiguos de estas mismas
# variables se siguen leyendo como alias: no hace falta reescribir tu .env.
# También se acepta VITO_MODELO (así lo escribió OnRoute), para que un mismo
# .env sirva para los dos productos.
# Ganan los de arriba si están puestos.
